{
  "version": 3,
  "routes": [
    {
      "src": "^/(index\\.html|flutter_bootstrap\\.js|main\\.dart\\.js|flutter_service_worker\\.js|version\\.json)$",
      "headers": { "cache-control": "no-cache" },
      "continue": true
    },
    {
      "src": "^/canvaskit/(.*)$",
      "headers": { "cache-control": "public, max-age=2592000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
